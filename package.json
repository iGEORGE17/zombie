{
  "name": "antidote-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "package": "npm run build && rm -f antidote-run-crazygames.zip && cd dist && zip -qr ../antidote-run-crazygames.zip . && cd .. && unzip -l antidote-run-crazygames.zip",
    "media": "node tools/capture-media.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/saira-stencil-one": "^5.3.0"
  }
}
